<?php
// sitemap.xml
// Dynamic Sitemap XML Generator

header("Content-Type: application/xml; charset=utf-8");
echo '<?xml version="1.0" encoding="UTF-8"?>' . "\n";
?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <!-- Static Routes -->
    <url>
        <loc><?php echo e(BASE_URL); ?>/</loc>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc><?php echo e(BASE_URL); ?>/destinations</loc>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>
    <url>
        <loc><?php echo e(BASE_URL); ?>/experiences</loc>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>
    <url>
        <loc><?php echo e(BASE_URL); ?>/news</loc>
        <changefreq>daily</changefreq>
        <priority>0.8</priority>
    </url>
    <url>
        <loc><?php echo e(BASE_URL); ?>/accessibility</loc>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>
    <url>
        <loc><?php echo e(BASE_URL); ?>/contact</loc>
        <changefreq>monthly</changefreq>
        <priority>0.5</priority>
    </url>

    <!-- Dynamic Category Routes -->
    <?php
    $pm = new PostManager();
    $categories = $pm->getCategories();
    foreach ($categories as $cat):
        ?>
        <url>
            <loc><?php echo e(BASE_URL); ?>/category/<?php echo e($cat['slug']); ?></loc>
            <changefreq>weekly</changefreq>
            <priority>0.7</priority>
        </url>
    <?php endforeach; ?>

    <!-- Dynamic Posts Routes -->
    <?php
    // Fetch all published posts
    $postsResult = $pm->getPosts(['status' => 'PUBLISHED', 'limit' => 500]);
    foreach ($postsResult['data'] as $post):
        $lastmod = !empty($post['updated_at']) ? date('Y-m-d', strtotime($post['updated_at'])) : date('Y-m-d');
        ?>
        <url>
            <loc><?php echo e(BASE_URL); ?>/posts/<?php echo e($post['slug']); ?></loc>
            <lastmod><?php echo $lastmod; ?></lastmod>
            <changefreq>weekly</changefreq>
            <priority>0.6</priority>
        </url>
    <?php endforeach; ?>
</urlset>
